ENVIRONMENT=development
JWT_SECRET=replace-with-at-least-32-random-characters
# Development only. Production configuration rejects SQLite.
DATABASE_URL=sqlite:///instance/connect_v2.db
COOKIE_SECURE=false
ALLOW_REGISTRATION=false
CORS_ORIGINS=["http://localhost:5000","http://127.0.0.1:5000","http://localhost:8080"]
ALLOWED_HOSTS=["localhost","127.0.0.1","testserver"]

# Docker deployment: set URL-safe random passwords and your real HTTPS domain.
# POSTGRES_PASSWORD=
# CORS_ORIGINS=["https://connect.example.com"]
# ALLOWED_HOSTS=["connect.example.com"]
