SECRET_KEY=replace-with-a-long-random-secret
DATABASE_URL=sqlite:///shk_connect.db
PORT=5000
FLASK_DEBUG=0
AUTO_CREATE_DB=1
SOCKETIO_ASYNC_MODE=threading
SOCKETIO_CORS_ORIGINS=
SESSION_COOKIE_SECURE=0

# Optional first-run bootstrap; existing accounts are never reset.
ADMIN_EMAIL=admin@shk.com
ADMIN_PASSWORD=
